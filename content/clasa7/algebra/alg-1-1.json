      "raspuns": "{{k}}",
      "indiciu": "Caută numărul care, înmulțit cu el însuși, dă ${{n}}$.",
      "rezolvare": "${{k}}^2 = {{n}}$, deci $\\sqrt{{{n}}} = {{k}}$."
    },
